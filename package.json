{
  "dependencies": {
    "@cosmjs/cosmwasm-stargate": "^0.39.0",
    "@cosmjs/proto-signing": "^0.39.0",
    "@cosmjs/stargate": "^0.39.0",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/qorex-rainbowkit": "^0.1.0",
    "@qorechain/rdk": "^0.9.0",
    "@qorechain/sdk": "^0.14.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.107.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.0.0",
    "wagmi": "^2.19.5"
  },
  "description": "QoreVest: an EVM token with Native vesting on the QoreChain testnet (qorechain-diana). Vesting claims settle atomically through the cross-VM bridge precompile to an approved Native (CosmWasm) contract.",
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "ganache": "^7.9.2",
    "solc": "^0.8.24",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.21"
  },
  "name": "qore-vest",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "compile": "npx solc@0.8.24 --optimize --abi --bin -o out contracts/QoreVest.sol contracts/MockCrossVm.sol && node scripts/build-artifact.mjs",
    "deploy": "tsx --env-file=.env scripts/deploy.ts",
    "dev": "vite",
    "preview": "vite preview",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify-live": "tsx scripts/verify-live.ts",
    "window": "tsx --env-file=.env scripts/window.ts",
    "prebuild": "node scripts/gen-evidence.mjs"
  },
  "type": "module",
  "version": "0.0.0"
}
